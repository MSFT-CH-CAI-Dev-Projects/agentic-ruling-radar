# Ruling Radar — web (BFF + UI) environment template.
# Copy to `.env.local` and fill in. Local dev authenticates via `az login`
# (DefaultAzureCredential), so no client secret is required for Azure AD
# data-plane access when you are logged in.

# --- Microsoft Foundry (required) --------------------------------------
# Project endpoint. NOTE: use the services.ai.azure.com host (NOT
# cognitiveservices.azure.com) — the hosted-agent invocations route only
# works against the services.ai.azure.com form.
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry>.services.ai.azure.com/api/projects/<your-project>

# Registered hosted-agent names. Defaults shown; override only if you
# registered the agents under different names.
FOUNDRY_TRIAGE_AGENT_NAME=agent-triage
FOUNDRY_SUMMARY_AGENT_NAME=agent-summary

# --- Cosmos DB (required for persistence) ------------------------------
AZURE_COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/

# --- Optional: Microsoft Graph + SharePoint draft publishing -----------
# Only needed if you enable the "publish draft to SharePoint" flow.
GRAPH_TENANT_ID=<your-tenant-id>
GRAPH_APP_CLIENT_ID=<your-app-client-id>
GRAPH_APP_CLIENT_SECRET=<your-app-client-secret>
SHAREPOINT_DRIVE_ID=<your-sharepoint-drive-id>
SHAREPOINT_SITE_URL=https://<your-tenant>.sharepoint.com/sites/<your-site>
