# Root azd environment reference (template).
# azd keeps the LIVE values under .azure/<env>/ (gitignored). Set values
# with `azd env set <KEY> <VALUE>` (use `azd env set --secret` for secrets).
# Your real, filled-in values belong in a local `.env` (gitignored).

AZURE_ENV_NAME="ruling-radar"
AZURE_SUBSCRIPTION_ID="<your-subscription-id>"
AZURE_LOCATION="switzerlandnorth"
AZURE_FOUNDRY_LOCATION="switzerlandnorth"

# --- Optional: Microsoft Graph + SharePoint draft publishing -----------
GRAPH_TENANT_ID="<your-tenant-id>"
GRAPH_APP_CLIENT_ID="<your-app-client-id>"
GRAPH_APP_CLIENT_SECRET="<your-app-client-secret>"
SHAREPOINT_DRIVE_ID="<your-sharepoint-drive-id>"
SHAREPOINT_SITE_URL="https://<your-tenant>.sharepoint.com/sites/<your-site>"
